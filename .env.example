# ─── TELEGRAM ────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=           # https://your-railway-app.up.railway.app/api/webhook
TELEGRAM_WEBHOOK_SECRET=        # Random string for webhook validation

# ─── OPENAI ──────────────────────────────────────
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-5.5-pro
USE_OLLAMA=false
OLLAMA_ENABLED=false
OLLAMA_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=gemma3:4b
OLLAMA_EMBED_MODEL=nomic-embed-text

# ─── FALLBACK AI PROVIDERS (optional) ───────────
GROQ_API_KEY=
GEMINI_API_KEY=
ADDIS_AI_API_KEY=          # Amharic/Afan Oromo transcription + polish

# ─── SUPABASE ────────────────────────────────────
# apps/web reads the NEXT_PUBLIC_-prefixed names (src/lib/supabase-browser.js,
# validateEnv.js) — set both if something else still reads the bare names.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── CHAPA (Payment) ────────────────────────────
CHAPA_SECRET_KEY=
CHAPA_WEBHOOK_SECRET=

# ─── SECURITY (required — app fails closed without these) ──
ENCRYPTION_KEY=             # AES-GCM key for bot token encryption
CRON_SECRET=                # Bearer token for all /api/cron/* routes, 16+ chars
ADMIN_SESSION_SECRET=       # HMAC key for the mm_admin_session cookie
ADMIN_TELEGRAM_IDS=         # Comma-separated platform admin Telegram IDs
PLATFORM_ADMIN_TELEGRAM_ID= # Single admin for Telegram notifications

# ─── SEARCH BOT ──────────────────────────────────
SEARCH_BOT_TOKEN=
SEARCH_BOT_WEBHOOK_SECRET=

# ─── OBSERVABILITY ───────────────────────────────
SENTRY_DSN=                 # apps/web/instrumentation.js won't init Sentry without this
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ─── APP ─────────────────────────────────────────
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000
WEB_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3001
TIMEZONE=Africa/Addis_Ababa
