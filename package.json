{
  "name": "minime",
  "version": "1.0.0",
  "private": true,
  "workspaces": ["packages/*", "apps/*"],
  "overrides": {
    "react": "19.1.9",
    "react-dom": "19.1.9",
    "axios": "1.20.0",
    "ws": "8.22.0",
    "fast-uri": "3.1.8",
    "nanoid": "3.3.19",
    "postcss": "8.5.28"
  },
  "scripts": {
    "bot": "cd apps/bot && node index.js",
    "bot:dev": "cd apps/bot && npx nodemon index.js",
    "web": "cd apps/web && npm run dev",
    "web:build": "cd apps/web && npm run build"
  }
}
